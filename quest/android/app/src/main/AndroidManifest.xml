<?xml version="1.0" encoding="utf-8"?>
<!-- Gran Turismo 4 VR (Meta Quest + Pico): a 2D start screen picks the version, each version is a
     NativeActivity running an immersive OpenXR session. The game data is the user's own disc image. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <uses-feature android:glEsVersion="0x00030002" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.level" android:version="1" android:required="true" />
    <uses-feature android:name="android.hardware.vr.headtracking" android:version="1" android:required="true" />
    <uses-feature android:name="oculus.software.handtracking" android:required="false" />

    <!-- Network play (GT4 Online): the emulated PS2 network adapter talks to the ad hoc relay. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="com.oculus.permission.HAND_TRACKING" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />

    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
        <intent>
            <action android:name="org.khronos.openxr.OpenXRRuntimeService" />
        </intent>
        <intent>
            <action android:name="org.khronos.openxr.OpenXRApiLayerService" />
        </intent>
    </queries>

    <application
        android:label="${appLabel}"
        android:icon="@mipmap/${appIcon}"
        android:allowBackup="false"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <!-- simpleperf from adb shell on the release build (no debuggable needed) -->
        <profileable android:shell="true" />

        <!-- Meta Quest -->
        <meta-data android:name="com.oculus.supportedDevices" android:value="quest2|questpro|quest3|quest3s" />
        <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />
        <!-- Pico (OpenXR through the Khronos loader) -->
        <meta-data android:name="pvr.app.type" android:value="vr" />
        <meta-data android:name="pvr.display.orientation" android:value="180" />

        <!-- Start screen (2D panel): picks Spec II or the online version (LauncherActivity). -->
        <activity
            android:name=".LauncherActivity"
            android:label="${appLabel}"
            android:enabled="${selectorEnabled}"
            android:exported="true"
            android:excludeFromRecents="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The two game versions: own native library, own process (the game's globals are not
             re-entrant and the process ends with the activity), own task. -->
        <activity
            android:name=".SpecIIActivity"
            android:label="${appLabel}"
            android:process=":specii"
            android:taskAffinity="online.portroyale.gt4vr.specii"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:resizeableActivity="false"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|layoutDirection|locale"
            android:exported="false">
            <meta-data android:name="android.app.lib_name" android:value="gt4vr_specii" />
            <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
            </intent-filter>
        </activity>
        <activity
            android:name=".OnlineActivity"
            android:label="${appLabel}"
            android:process=":online"
            android:taskAffinity="online.portroyale.gt4vr.online"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:resizeableActivity="false"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|layoutDirection|locale"
            android:exported="false">
            <meta-data android:name="android.app.lib_name" android:value="gt4vr_online" />
            <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
            </intent-filter>
        </activity>
        <!-- Single-version apps: the library entry starts the game's VR activity directly. -->
        <activity-alias
            android:name=".SpecIILauncher"
            android:targetActivity=".SpecIIActivity"
            android:label="${appLabel}"
            android:enabled="${speciiLauncher}"
            android:exported="true">
            <!-- NativeActivity reads lib_name from the LAUNCHED component: an alias needs its own copy. -->
            <meta-data android:name="android.app.lib_name" android:value="gt4vr_specii" />
            <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".OnlineLauncher"
            android:targetActivity=".OnlineActivity"
            android:label="${appLabel}"
            android:enabled="${onlineLauncher}"
            android:exported="true">
            <!-- NativeActivity reads lib_name from the LAUNCHED component: an alias needs its own copy. -->
            <meta-data android:name="android.app.lib_name" android:value="gt4vr_online" />
            <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
