From bde9247d4e7e03a1fb44c6cf1b381cbb360a8471 Mon Sep 17 00:00:00 2001
From: "Sgt.Bilko" <59089219+SgtBilko76@users.noreply.github.com>
Date: Sun, 8 Nov 2026 15:31:03 +0100
Subject: [PATCH 38/44] Quest VR HUD layer: full-screen effect = 600x200 (GT4
 field mode draws 640x224), not the black untextured fill GT4 draws every
 field

---
 pcsx2/GS/Renderers/HW/GSRendererHW.cpp | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/pcsx2/GS/Renderers/HW/GSRendererHW.cpp b/pcsx2/GS/Renderers/HW/GSRendererHW.cpp
index fb6e9fbe95..43ad6a6584 100644
--- a/pcsx2/GS/Renderers/HW/GSRendererHW.cpp
+++ b/pcsx2/GS/Renderers/HW/GSRendererHW.cpp
@@ -463,8 +463,11 @@ void GSRendererHW::RrvHudSplitNoteDraw()
 	const GSVector4 box = m_vt.m_min.p.xyxy(m_vt.m_max.p);
 	const bool tme = PRIM->TME;
 	const u32 tbp = m_cached_ctx.TEX0.TBP0;
-	// Full-screen effect (GT4 hit flash): belongs to the picture, not the HUD layer.
-	const bool full_screen = (box.z - box.x) >= 600.0f && (box.w - box.y) >= 400.0f;
+	// Full-screen effect (GT4 hit flash): belongs to the picture, not the HUD layer. GT4 runs in field
+	// mode here: a full field is 640x224 (owner 2026-11-08 log), so 400 rows never matched. The black
+	// untextured full-field fill GT4 draws every field after the HUD is not an effect.
+	const bool black_fill = !tme && (m_vt.m_max.c.U32[0] | m_vt.m_max.c.U32[1] | m_vt.m_max.c.U32[2]) == 0;
+	const bool full_screen = (box.z - box.x) >= 600.0f && (box.w - box.y) >= 200.0f && !black_fill;
 	if (s_split_fbp == static_cast<int>(fbp))
 	{
 		// Picture effects after the split (owner 2026-11-08, hit flash still on the HUD panel only with
@@ -484,7 +487,7 @@ void GSRendererHW::RrvHudSplitNoteDraw()
 		// the old log before the crash), plus every frame-reading draw.
 		static u32 s_dbg_after = 0;
 		const bool centre_hud = box.x >= 190.0f && box.x <= 198.0f && box.z >= 442.0f && box.z <= 450.0f;
-		if (s_dbg_after < 400 && (reads_frame || (!centre_hud && ((box.z - box.x) >= 200.0f || (box.w - box.y) >= 150.0f))) && ++s_dbg_after)
+		if (s_dbg_after < 400 && !black_fill && (reads_frame || (!centre_hud && ((box.z - box.x) >= 200.0f || (box.w - box.y) >= 150.0f))) && ++s_dbg_after)
 			std::fprintf(stderr, "[hud-layer] after split: draw %d prims %u fbp 0x%x tme %d tbp 0x%x psm %u tpsm %u ztst %u%s box %.0f,%.0f-%.0f,%.0f rgba %u,%u,%u,%u alpha %016llx -> %s\n",
 				s_n, static_cast<unsigned>(m_index->tail), fbp, tme ? 1 : 0, tbp, static_cast<unsigned>(m_cached_ctx.FRAME.PSM),
 				static_cast<unsigned>(m_cached_ctx.TEX0.PSM), static_cast<unsigned>(test.ZTST), test.ZTE ? "" : " (off)", box.x, box.y, box.z, box.w,
-- 
