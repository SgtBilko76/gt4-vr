+// RRV sprite coverage (GSRrvSetSpriteCoverage). True when every triangle of the
+// draw is half of an axis-aligned rectangle whose texture coordinates run with
+// the axes (one U or S for one X, one V or T for one Y; the caller has checked
+// that Q is constant for STQ): RR5 draws most of its HUD as such two-triangle
+// strips. A triangle qualifies with exactly one vertical and one horizontal
+// edge, so a rotated piece (the rev needle) or a degenerate triangle does not.
+bool GSRendererHW::RrvTrianglesAreTexelQuads()
+{
+	const u32 count = m_index->tail;
+	if (count < 3 || (count % 3) != 0 || count > 3 * 2048)
+		return false;
+
+	const GSVertex* v = &m_vertex->buff[0];
+	const u16* idx = m_index->buff;
+	const bool fst = PRIM->FST;
+	for (u32 i = 0; i < count; i += 3)
+	{
+		const GSVertex* t[3] = {&v[idx[i]], &v[idx[i + 1]], &v[idx[i + 2]]};
+		u32 vertical = 0, horizontal = 0;
+		for (u32 e = 0; e < 3; e++)
+		{
+			const GSVertex& p = *t[e];
+			const GSVertex& q = *t[(e + 1) % 3];
+			const bool same_x = p.XYZ.X == q.XYZ.X;
+			const bool same_y = p.XYZ.Y == q.XYZ.Y;
+			if (same_x == same_y)
+			{
+				if (same_x)
+					return false; // two vertices in one place
+				continue; // the diagonal
+			}
+			if (same_x)
+			{
+				if (fst ? (p.U != q.U) : (p.ST.S != q.ST.S))
+					return false;
+				vertical++;
+			}
+			else
+			{
+				if (fst ? (p.V != q.V) : (p.ST.T != q.ST.T))
+					return false;
+				horizontal++;
+			}
+		}
+		if (vertical != 1 || horizontal != 1)
+			return false;
+	}
+	return true;
+}
+
+// RRV sprite coverage (GSRrvSetSpriteCoverage), linear FST sprites from guest
+// memory above scale 1. The GS samples such a sprite once per native pixel:
+// the first at the sprite's first texture coordinate, the last one step
+// before its second (RR5's title logo: U 0.5 to 448.5 over 448 pixels, read at
+// 0.5, 1.5 ... 447.5, texels 0 to 447 of an atlas). The S host pixels inside
+// the last native pixel continue past that, up to (S - 1) / S of a step, and
+// show the atlas texel next to the piece: a line at the right end or under
+// the title, PRESS START BUTTON, the namco logo and the copyright line
+// (owner report 2026-10-13; attract field 3900 at scale 4, with either
+// sprite filter and before this patch series). So the coordinate of the far
+// vertex is pulled in until the last host pixel reads what the last native
+// pixel does, or one texel before the end where a step is more than a texel
+// (the title's V: 49 texel rows in 24.5 field rows, the other field reads the
+// rows in between). The picture is the native one resampled, narrower by one
