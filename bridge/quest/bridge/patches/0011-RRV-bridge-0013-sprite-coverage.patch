+// RRV sprite coverage: point-sampled 2D at every output scale. RR5 draws its
+// HUD, menus, text and logos as FST sprites and as two-triangle rectangles with
+// TEX1 NEAREST; a host pixel then takes one texel, so a texel is as many host
+// pixels wide as the ratio rounds to: even only when one texel covers a whole
+// number of host pixels (fonts are full-height textures in half-height field
+// sprites, 2 / N rows per texel at scale N: rows dropped at 1, strokes of 1
+// and 2 rows at 3; 0.75 N columns per texel under the bridge's 4:3 HUD on a
+// wide picture, where the stock texel rounding of a moved sprite also takes
+// the wrong first and last texel). When set, such a draw that reads guest
+// memory (not a render target) has each host pixel take the average of the
+// texels under its own area (the shader's 4-tap path with weights from the UV
+// derivatives, SpriteCov in the pixel constants); sprites keep the texels the
+// RoundSprite fix finds, now at scale 1 too. A texel boundary on a host pixel
+// boundary gives the stock picture; anywhere else the pixel is the exact mix.
+// Draws that sample render targets, linear draws and 3D are untouched. Off
+// (the default) = stock. The count is the monotonic total of draws it applied
+// to.
+void GSRrvSetSpriteCoverage(bool on);
+u64 GSRrvGetSpriteCoverageDraws();
+// A sprite the bridge has moved (its X is no longer the game's) cannot have the
+// texels it spans found from its position, so the bridge finds them from the
+// game's coordinates, writes them to U and marks the sprite: RoundSpriteOffset()
+// then leaves the U of a sprite with exactly these X and U ends alone (V is
+// still found from Y). The marks are cleared by the bridge once a field's draws
+// are flushed. Used only under sprite coverage.
+inline u64 GSRrvSpriteKey(u16 x0, u16 x1, u16 u0, u16 u1)
+{
+	return static_cast<u64>(x0) | (static_cast<u64>(x1) << 16) | (static_cast<u64>(u0) << 32) | (static_cast<u64>(u1) << 48);
+}
+void GSRrvMarkAlignedSprite(u64 key);
+bool GSRrvIsAlignedSprite(u64 key);
+void GSRrvClearAlignedSprites();
 // RRV Gate-6 extension: when set, UserHacks_RewriteLargeST also collapses
 // every triangle whose ST it had to rewrite (degenerate Q), so it draws nothing.
 void GSRrvSetDropLargeSTTriangles(bool drop);
