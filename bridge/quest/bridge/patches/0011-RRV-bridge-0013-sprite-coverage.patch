+// RRV sprite coverage (GSRrvSetSpriteCoverage, VS_RRV_SNAP; PointSize is then
+// half the target size in host pixels): an edge goes to the centre of the
+// first host pixel it covers, less 1/64 pixel so the pixel stays covered. The
+// same pixels are drawn, and every pixel's interpolated UV is the one of its
+// own first corner whatever fraction of a host pixel the edge was at (half
+// rows, the bridge's 4:3 HUD), which is what the pixel shader's texel weights
+// assume. `t` is the position with Y down.
+#if VS_RRV_SNAP
+float2 rrv_snap(float2 t)
+{
+	float2 pixel = (t + 1.0f) * PointSize;
+	pixel = ceil(pixel - 0.5f) + (0.5f - 1.0f / 64.0f);
+	return pixel / PointSize - 1.0f;
+}
+#endif
