From 3379dadd5521eb5b8afc65fb4ac9292619bc1e45 Mon Sep 17 00:00:00 2001
From: "Sgt.Bilko" <59089219+SgtBilko76@users.noreply.github.com>
Date: Wed, 28 Oct 2026 21:16:53 +0100
Subject: [PATCH 05/44] RRV bridge 0006: full-frame canonical field OFY

Fukami tools/patches/pcsx2/0006 on ARMSX2: s_n/s_transfer_n are per-object
members here, so only the RRV statics are defined; GSState.h keeps
ARMSX2's include list (it already has <atomic>).
---
 pcsx2/GS/GS.cpp      | 12 ++++++++++++
 pcsx2/GS/GS.h        |  7 +++++++
 pcsx2/GS/GSState.cpp | 12 +++++++++++-
 pcsx2/GS/GSState.h   |  5 +++++
 4 files changed, 35 insertions(+), 1 deletion(-)

diff --git a/pcsx2/GS/GS.cpp b/pcsx2/GS/GS.cpp
index 57fdc8a075..b787c8d2f2 100644
--- a/pcsx2/GS/GS.cpp
+++ b/pcsx2/GS/GS.cpp
@@ -82,6 +82,18 @@ u64 GSRrvGetDirectPresentCount()
 	return s_rrv_direct_present_count.load(std::memory_order_relaxed);
 }
 
+void GSRrvSetFieldOfyCanonical(u32 from_ofy, u32 to_ofy)
+{
+	GSState::s_rrv_ofy_from = from_ofy & 0xFFFFu;
+	GSState::s_rrv_ofy_to = to_ofy & 0xFFFFu;
+	GSState::s_rrv_ofy_canonical_count.store(0, std::memory_order_relaxed);
+}
+
+u64 GSRrvGetFieldOfyCanonicalCount()
+{
+	return GSState::s_rrv_ofy_canonical_count.load(std::memory_order_relaxed);
+}
+
 static GSRendererType GSCurrentRenderer;
 static bool GSCurrentPresenterOffsetsRead;
 
diff --git a/pcsx2/GS/GS.h b/pcsx2/GS/GS.h
index 0b67acc31c..317195af6b 100644
--- a/pcsx2/GS/GS.h
+++ b/pcsx2/GS/GS.h
@@ -86,6 +86,13 @@ void GSgifTransfer3(u8* mem, u32 size);
 void GSRrvResetDirectPresentCount();
 void GSRrvRecordDirectPresent();
 u64 GSRrvGetDirectPresentCount();
+// RRV Gate-6 full-frame extension. When from != to, every XYOFFSET_1/2 write
+// whose OFY equals `from` is stored with OFY = `to` before any draw, culling,
+// scissor or texture-cache decision uses it. The bridge uses this to put both
+// field parities of a half-line (sceGsSetHalfOffset-style) odd-field offset on
+// one progressive raster grid. from == to (the default) is a no-op.
+void GSRrvSetFieldOfyCanonical(u32 from_ofy, u32 to_ofy);
+u64 GSRrvGetFieldOfyCanonicalCount();
 void GSvsync(u32 field, bool registers_written);
 // Manual frameskip (Android low-end devices): present 1 of every (frames+1)
 // VSyncs, skipping presentation of the rest. 0 disables. See GSRenderer::VSync.
diff --git a/pcsx2/GS/GSState.cpp b/pcsx2/GS/GSState.cpp
index 7b73546a13..569c02b8af 100644
--- a/pcsx2/GS/GSState.cpp
+++ b/pcsx2/GS/GSState.cpp
@@ -24,6 +24,9 @@
 #include <bit>
 #include <thread>
 
+u32 GSState::s_rrv_ofy_from = 0;
+u32 GSState::s_rrv_ofy_to = 0;
+std::atomic<u64> GSState::s_rrv_ofy_canonical_count{0};
 
 GSHWAutoFlushLevel GSState::GetAutoFlushLevel() const
 {
@@ -3154,7 +3157,14 @@ void GSState::GIFRegHandlerXYOFFSET(const GIFReg* RESTRICT r)
 {
 	GL_REG("XYOFFSET_%d = 0x%x_%x", i, r->U32[1], r->U32[0]);
 
-	const u64 r_masked = r->U64 & XYOFFSET_REG_MASK;
+	u64 r_masked = r->U64 & XYOFFSET_REG_MASK;
+
+	// RRV Gate-6 full-frame extension: canonical field OFY (off unless set).
+	if (s_rrv_ofy_from != s_rrv_ofy_to && static_cast<u32>((r_masked >> 32) & 0xFFFFu) == s_rrv_ofy_from)
+	{
+		r_masked = (r_masked & 0x0000FFFFULL) | (static_cast<u64>(s_rrv_ofy_to) << 32);
+		s_rrv_ofy_canonical_count.fetch_add(1, std::memory_order_relaxed);
+	}
 
 	if (i == m_prev_env.PRIM.CTXT)
 	{
diff --git a/pcsx2/GS/GSState.h b/pcsx2/GS/GSState.h
index 844a711fb4..0e995ba705 100644
--- a/pcsx2/GS/GSState.h
+++ b/pcsx2/GS/GSState.h
@@ -622,6 +622,11 @@ public:
 	u64 s_last_transfer_draw_n = 0;
 	u64 s_transfer_n = 0;
 
+	// RRV Gate-6 full-frame extension, see GSRrvSetFieldOfyCanonical().
+	static u32 s_rrv_ofy_from;
+	static u32 s_rrv_ofy_to;
+	static std::atomic<u64> s_rrv_ofy_canonical_count;
+
 	GSPerfMon m_perfmon_frame; // Track stat across a frame.
 	GSPerfMon m_perfmon_draw;  // Track stat across a draw.
 
