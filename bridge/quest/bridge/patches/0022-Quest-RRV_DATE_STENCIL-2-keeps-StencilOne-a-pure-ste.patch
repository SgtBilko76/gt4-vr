From 60504d35f0a65ddbc4af9a66021443e1708e8c7d Mon Sep 17 00:00:00 2001
From: "Sgt.Bilko" <59089219+SgtBilko76@users.noreply.github.com>
Date: Thu, 29 Oct 2026 16:20:35 +0100
Subject: [PATCH 22/44] Quest: RRV_DATE_STENCIL=2 keeps StencilOne a pure
 stencil test (A/B only: white scene on Adreno 740)

---
 pcsx2/GS/Renderers/HW/GSRendererHW.cpp | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/pcsx2/GS/Renderers/HW/GSRendererHW.cpp b/pcsx2/GS/Renderers/HW/GSRendererHW.cpp
index a1192853d4..ecd29554c9 100644
--- a/pcsx2/GS/Renderers/HW/GSRendererHW.cpp
+++ b/pcsx2/GS/Renderers/HW/GSRendererHW.cpp
@@ -7107,8 +7107,11 @@ void GSRendererHW::EmulateDATEGetConfig(DATEOptions& date_options, bool scale_rt
 	}
 	else if (date_options.stencil_one)
 	{
+		// RRV_DATE_STENCIL=2: keep StencilOne a pure stencil test (exact: only the first write can
+		// pass) instead of upgrading it to an in-pass RT read with a barrier.
+		static const bool s_rrv_pure_stencil_one = [] { const char* v = std::getenv("RRV_DATE_STENCIL"); return v && v[0] == '2'; }();
 		const bool multidraw_fb_copy = m_conf.require_one_barrier || (m_conf.require_full_barrier && features.multidraw_fb_copy);
-		if (features.texture_barrier || multidraw_fb_copy)
+		if (!s_rrv_pure_stencil_one && (features.texture_barrier || multidraw_fb_copy))
 		{
 			m_conf.require_one_barrier = true;
 			m_conf.ps.date = 5 + m_cached_ctx.TEST.DATM;
-- 
