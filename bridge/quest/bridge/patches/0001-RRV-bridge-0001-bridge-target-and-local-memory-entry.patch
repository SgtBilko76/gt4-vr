 }
 
+// ARMSX2 port of the RRV bridge entry points: ARMSX2's GS can split parsing and
+// rendering across a front object and a back thread (GSConfig.BackThreadMode).
+// The bridge reads and writes g_gs_renderer's transfer cursor and local memory
+// directly, which is only coherent with a single, unqueued GS object (mode Off,
+// the default). Fail closed otherwise instead of racing the back thread.
+static bool GSRrvDirectAccessSafe()
+{
+	return g_gs_renderer && !g_gs_front && !g_gs_renderer->m_back_queued;
+}
+
+void GSSyncRasterizer()
+{
+	// RRV GS-bridge extension. Every bridge entry point that reads GS local
+	// memory behind the renderer's back must call this first: with
+	// GSOptions::SWExtraThreads > 0 the software rasterizer's workers are still
+	// writing the framebuffer/Z pages when Transfer() returns, and PCSX2's own
+	// equivalents (GSInitAndReadFIFO -> InitReadFIFO -> InvalidateLocalMem,
+	// GetOutput -> Sync(1)) do exactly this on the paths it owns. Cheap when
+	// nothing is queued; a no-op with a single-threaded or hardware renderer.
+	if (g_gs_renderer)
+		g_gs_renderer->RrvSyncRasterizer();
+}
+
+bool GSReadLocalMemoryChecked(u8* mem, u32 byte_count, u64 BITBLITBUF, u64 TRXPOS, u64 TRXREG)
+{
+	if (!GSRrvDirectAccessSafe() || !mem)
+		return false;
+	GSSyncRasterizer();
+	return g_gs_renderer->RrvReadLocalMemoryChecked(
+		mem, byte_count, GIFRegBITBLTBUF{BITBLITBUF}, GIFRegTRXPOS{TRXPOS}, GIFRegTRXREG{TRXREG});
+}
+
+bool GSSnapshotLocalMemory(u8* mem, u32 size)
+{
+	if (!GSRrvDirectAccessSafe() || !mem || size != GSLocalMemory::m_vmsize)
+		return false;
+
+	// The bridge invokes this only in its serialized GS context. Flush finalizes
+	// the current primitive, ReadbackTextureCache materializes Hardware/Metal's
+	// authoritative render/depth targets into the CPU-visible GS VM, and the
+	// rasterizer sync retires multithreaded Software work. A bare memcpy here is
+	// not sufficient: on Hardware renderers m_mem deliberately trails the GPU
+	// target cache until PCSX2 performs this same readback operation.
+	g_gs_renderer->Flush(GSState::GSFlushReason::LOADSTATE);
+	g_gs_renderer->RrvSyncRasterizer();
+	g_gs_renderer->ReadbackTextureCache();
+	std::memcpy(mem, g_gs_renderer->m_mem.vm8(), GSLocalMemory::m_vmsize);
+	return true;
+}
+
+bool GSRestoreLocalMemory(const u8* mem, u32 size)
+{
+	if (!GSRrvDirectAccessSafe() || !mem || size != GSLocalMemory::m_vmsize)
+		return false;
+
+	g_gs_renderer->Flush(GSState::GSFlushReason::LOADSTATE);
+	// A queued draw would otherwise land on top of the image we just restored.
+	g_gs_renderer->RrvSyncRasterizer();
+	std::memcpy(g_gs_renderer->m_mem.vm8(), mem, GSLocalMemory::m_vmsize);
+	// The CPU-visible VM changed outside normal GS transfer paths. No cached
+	// source/target may outlive it, and CLUT state must reload on next use.
+	g_gs_renderer->m_mem.ResetCLUT();
+	g_gs_renderer->PurgeTextureCache(true, true, true);
+	return true;
+}
+
 void GSgifTransfer(const u8* mem, u32 size)
 {
 	GSParseTarget()->Transfer<3>(mem, size);
