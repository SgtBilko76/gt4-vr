 pcsx2/GS/GS.cpp          | 85 ++++++++++++++++++++++++++++++++++++++++
 pcsx2/GS/GS.h            | 16 ++++++++
 pcsx2/GS/GSLocalMemory.h |  1 +
 pcsx2/GS/GSState.cpp     | 72 ++++++++++++++++++++++++++++++++++
 pcsx2/GS/GSState.h       | 11 ++++++
 6 files changed, 200 insertions(+)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 0b29dcfa14..79f86c074d 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -48,6 +48,21 @@ add_subdirectory(common)
 # make pcsx2
 add_subdirectory(pcsx2)
 
+if(DEFINED RRV_PCSX2_GS_BRIDGE_SOURCE_DIR)
+    # Escape hatch only. Forcing PCSX2's C reference scanline was the bridge's
+    # original workaround for not owning PCSX2's code reserve, and on ARM64 that
+    # reference path does NOT match the JIT rasterizer the reference runner uses
+    # (measured: dark 0.083 vs 0.014 on the same stream) -- it was the whole of
+    # KNOWN_ISSUES #21. The bridge now allocates the code reserve itself, so the
+    # JIT is the default and this stays OFF.
+    option(RRV_PCSX2_GS_BRIDGE_C_SCANLINE
+           "Force PCSX2's C reference scanline instead of the SW JIT rasterizer" OFF)
+    if(RRV_PCSX2_GS_BRIDGE_C_SCANLINE)
+        target_compile_definitions(PCSX2 PRIVATE RRV_PCSX2_GS_C_SCANLINE=1)
+    endif()
+    add_subdirectory("${RRV_PCSX2_GS_BRIDGE_SOURCE_DIR}" pcsx2-gs-bridge)
+endif()
+
 if(ENABLE_QT_UI)
 	add_subdirectory(pcsx2-qt)
 endif()
