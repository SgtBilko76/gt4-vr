index 7835e106ed..87de681f31 100644
--- a/pcsx2/GS/Renderers/Vulkan/GSDeviceVK.cpp
+++ b/pcsx2/GS/Renderers/Vulkan/GSDeviceVK.cpp
@@ -133,10 +133,56 @@ static void Hit(int kind, u64 px)
 	s.px = px;
 	s_slots.push_back(s);
 }
+// RRV_VKDIAG_REASONS: per draw, why it reads the render target, and whether it switches the
+// feedback state against the previous draw into the same target (each switch ends the pass).
+enum Reason
+{
+	R_DRAWS, R_READ, R_TEX_IS_FB, R_FBMASK, R_DATE5, R_SWBLEND, R_AFAIL, R_HAZARD, R_DEPTHREAD,
+	R_SWITCH, R_NEW_TARGET, R_COUNT
+};
+static const char* const kReasonNames[R_COUNT] = {"draws", "read-rt", "tex_is_fb", "fbmask", "date>=5",
+	"sw_blend", "afail", "tex_hazard", "read-depth", "fb-switch", "target-change"};
+static u64 s_reason[R_COUNT] = {};
+static const void* s_last_rt = nullptr;
+static bool s_last_read = false;
+static void Draw(const GSHWDrawConfig& c, bool read_rt, bool read_depth)
+{
+	if (!On())
+		return;
+	const auto& ps = c.ps;
+	s_reason[R_DRAWS]++;
+	if (read_rt)
+	{
+		s_reason[R_READ]++;
+		const u32 sw = ps.blend_a | ps.blend_b | ps.blend_d;
+		if (ps.tex_is_fb) s_reason[R_TEX_IS_FB]++;
+		if (ps.fbmask) s_reason[R_FBMASK]++;
+		if (ps.date >= 5) s_reason[R_DATE5]++;
+		if ((sw != 0 && ((sw | ps.blend_c) & 1u)) || ((ps.a_masked & ps.blend_c) != 0)) s_reason[R_SWBLEND]++;
+		if (ps.afail == GSHWDrawConfig::PS_AFAIL::ZB_ONLY || ps.afail == GSHWDrawConfig::PS_AFAIL::RGB_ONLY || ps.afail == GSHWDrawConfig::PS_AFAIL::RGB_ONLY_SW_Z)
+			s_reason[R_AFAIL]++;
+		if (c.tex_hazard == GSHWDrawConfig::TEX_HAZARD_RT) s_reason[R_HAZARD]++;
+	}
+	if (read_depth)
+		s_reason[R_DEPTHREAD]++;
+	if (c.rt != s_last_rt)
+		s_reason[R_NEW_TARGET]++;
+	else if (read_rt != s_last_read)
+		s_reason[R_SWITCH]++;
+	s_last_rt = c.rt;
+	s_last_read = read_rt;
+}
+
 static void Present()
 {
 	if (!On() || ++s_presents % 600u != 0u)
 		return;
+	std::fprintf(stderr, "[vkdiag] per present:");
+	for (int i = 0; i < R_COUNT; ++i)
+		std::fprintf(stderr, " %s=%.1f", kReasonNames[i], s_reason[i] / 600.0);
+	std::fprintf(stderr, "\n");
+	std::fill(std::begin(s_reason), std::end(s_reason), 0);
+	GSRrvBlendDiagPrint(600); // RRV_BLEND_DIAG
 	Dl_info info{};
 	dladdr(reinterpret_cast<void*>(&Present), &info);
 	const uintptr_t base = reinterpret_cast<uintptr_t>(info.dli_fbase);
@@ -9657,6 +9703,9 @@ void GSDeviceVK::UpdateHWPipelineSelector(GSHWDrawConfig& config, PipelineSelect
 
 	// enable point size in the vertex shader if we're rendering points regardless of upscaling.
 	pipe.vs.point_size |= (config.topology == GSHWDrawConfig::Topology::Point);
+#if defined(__ANDROID__)
+	rrv_vkdiag::Draw(config, config.IsFeedbackLoopRT(config.ps), config.IsFeedbackLoopDepth(config.ps)); // RRV_VKDIAG_REASONS
+#endif
 
 	// RRV_VK_VRS: coarse shading only into upscaled targets (wider than any native GS target).
 	pipe.rrv_coarse = (m_rrv_vrs && pipe.rt && config.rt && config.rt->GetWidth() > 2048 &&
