@@ -6867,7 +6867,18 @@ void GSRendererHW::EmulateDATESelectMethod(DATEOptions& date_options, GSTextureC
 	if (!date_options.enabled)
 		return;
 
-	const GSDevice::FeatureSupport& features = g_gs_device->Features();
+	// RRV_DATE_STENCIL=1 (Quest): pick the DATE method as if the device had no texture barrier,
+	// i.e. the stencil pre-pass instead of an in-pass RT read. On the Adreno 740 every RT-reading
+	// draw needs a feedback-loop render pass, and DATE (plus the software blending it then prefers)
+	// is nearly all of them in RR5's race (RRV_VKDIAG).
+	static const bool s_rrv_date_stencil = [] { const char* v = std::getenv("RRV_DATE_STENCIL"); return v && v[0] == '1'; }();
+	GSDevice::FeatureSupport rrv_features = g_gs_device->Features();
+	if (s_rrv_date_stencil)
+	{
+		rrv_features.texture_barrier = false;
+		rrv_features.multidraw_fb_copy = false;
+	}
+	const GSDevice::FeatureSupport& features = rrv_features;
 
 	// Date one can run with complex alpha test if there's no overlap.
 	const bool complex_alpha_test = m_cached_ctx.TEST.ATE &&
@@ -7932,6 +7943,48 @@ __ri u32 GSRendererHW::EmulateChannelShuffle(GSTextureCache::Target* src, bool t
 	return true;
 }
 
+#if defined(__ANDROID__)
+// RRV_BLEND_DIAG histogram (GS thread only).
+namespace
+{
+struct RrvBlendKey
+{
+	u32 why, abcd, afix, overlap, prim, amin, amax;
+	bool operator==(const RrvBlendKey& o) const { return std::memcmp(this, &o, sizeof(*this)) == 0; }
+};
+std::vector<std::pair<RrvBlendKey, u64>> s_rrv_blend;
+} // namespace
+static void GSRrvBlendDiagHit(u32 why, u32 abcd, u32 afix, u32 overlap, u32 prim, int amin, int amax)
+{
+	static const bool on = [] { const char* v = std::getenv("RRV_VKDIAG"); return v && v[0] == '1'; }();
+	if (!on)
+		return;
+	const RrvBlendKey k{why, abcd, afix, overlap, prim, static_cast<u32>(amin), static_cast<u32>(amax)};
+	for (auto& e : s_rrv_blend)
+		if (e.first == k)
+		{
+			++e.second;
+			return;
+		}
+	if (s_rrv_blend.size() < 256)
+		s_rrv_blend.push_back({k, 1});
+}
+void GSRrvBlendDiagPrint(unsigned presents)
+{
+	std::sort(s_rrv_blend.begin(), s_rrv_blend.end(), [](const auto& a, const auto& b) { return a.second > b.second; });
+	for (size_t i = 0; i < s_rrv_blend.size() && i < 12; ++i)
+	{
+		const RrvBlendKey& k = s_rrv_blend[i].first;
+		std::fprintf(stderr, "[vkdiag] swblend n/f=%6.1f why=0x%03x ABCD=%u%u%u%u FIX=%u overlap=%u prim=%u alpha=%u..%u\n",
+			s_rrv_blend[i].second / static_cast<double>(presents), k.why, k.abcd & 3, (k.abcd >> 2) & 3, (k.abcd >> 4) & 3,
+			(k.abcd >> 6) & 3, k.afix, k.overlap, k.prim, k.amin, k.amax);
+	}
+	s_rrv_blend.clear();
+}
+#else
+void GSRrvBlendDiagPrint(unsigned) {}
+#endif
+
 void GSRendererHW::EmulateBlending(int rt_alpha_min, int rt_alpha_max, DATEOptions& date_options,
 	GSTextureCache::Target* rt, bool can_scale_rt_alpha, bool& new_rt_alpha_scale)
 {
@@ -8376,6 +8429,25 @@ void GSRendererHW::EmulateBlending(int rt_alpha_min, int rt_alpha_max, DATEOptio
 		color_dest_blend2 = false;
 		blend_zero_to_one_range = false;
 	}
+#if defined(__ANDROID__)
+	if (sw_blending) // RRV_BLEND_DIAG
+	{
+		u32 why = 0;
+		why |= (blend_flag & BLEND_A_MAX) ? 1u : 0u;
+		why |= (one_barrier && (no_prim_overlap || features.framebuffer_fetch)) ? 2u : 0u;
+		why |= (!(blend_flag & BLEND_HW2) && !blend_multipass_group && (alpha_c2_high_one || alpha_c0_high_max_one) && no_prim_overlap) ? 4u : 0u;
+		why |= (blend_ad && !blend_multipass_group && no_prim_overlap && !new_rt_alpha_scale) ? 8u : 0u;
+		why |= prefer_sw_blend ? 16u : 0u;
+		why |= free_blend ? 32u : 0u;
+		why |= blend_mix_alpha_over_one ? 64u : 0u;
+		why |= blend_mix ? 128u : 0u;
+		why |= force_sw_blending ? 256u : 0u;
+		why |= date_options.enabled ? 512u : 0u;
+		why |= PABE ? 1024u : 0u;
+		GSRrvBlendDiagHit(why, (m_conf.ps.blend_a) | (m_conf.ps.blend_b << 2) | (m_conf.ps.blend_c << 4) | (m_conf.ps.blend_d << 6),
+			AFIX, static_cast<u32>(m_prim_overlap), static_cast<u32>(m_vt.m_primclass), GetAlphaMinMax().min, GetAlphaMinMax().max);
+	}
+#endif
 
 	// Color clip
 	if (COLCLAMP.CLAMP == 0)
