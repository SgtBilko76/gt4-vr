+	// Use a different semaphore for each image.
+	m_current_semaphore = (m_current_semaphore + 1) % static_cast<u32>(m_semaphores.size());
+	{
+		std::lock_guard lock(m_rrv_acquire->mutex);
+		m_rrv_acquire->swap_chain = m_swap_chain;
+		m_rrv_acquire->semaphore = m_semaphores[m_current_semaphore].available_semaphore;
+		m_rrv_acquire->done = false;
+		m_rrv_acquire->request = true;
