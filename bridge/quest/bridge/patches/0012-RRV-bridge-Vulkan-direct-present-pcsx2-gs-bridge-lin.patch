-using BlockHashState = XXH3_state_t;
+// RRV (Linux/Vulkan bridge): the same stock XXH3 stream hash, without the copy of every 256-byte GS block into the
+// streaming state's buffer (libc memmove was 6% of the GS thread in the 14-car race start on the Steam Deck,
+// 119 of 187 samples from GSXXH3_64_Update; 2026-10-05). XXH3_64bits_update() holds each block in its buffer
+// until the next one arrives and then consumes the buffer. Here the previous block stays where it is (GS local
+// memory; nothing writes it while a texture is hashed), is consumed in place when the next block arrives, and the
+// final block is put in the buffer at the end, which is the state the stock update leaves. Any other update, and a
+// block that arrives when the buffer is not empty, goes through the stock update. The values are bit-identical.
+struct BlockHashState
+{
+	XXH3_state_t st;
+	const u8* pending; // a whole block that counts as "in the buffer" and is not copied there yet
+};
 
 __fi static void BlockHashReset(BlockHashState& st)
 {
-	XXH3_64bits_reset(&st);
+	XXH3_64bits_reset(&st.st);
+	st.pending = nullptr;
+}
+
+__fi static void BlockHashFlush(BlockHashState& st)
+{
+	if (!st.pending)
+		return;
+	memcpy(st.st.buffer, st.pending, GS_BLOCK_SIZE);
+	st.st.bufferedSize = GS_BLOCK_SIZE;
+	st.pending = nullptr;
 }
 
 __fi static void BlockHashAccumulate(BlockHashState& st, const u8* bp)
 {
-	GSXXH3_64bits_update(&st, bp, GS_BLOCK_SIZE);
+	static_assert(GS_BLOCK_SIZE == 256 && XXH3_INTERNALBUFFER_SIZE == 256);
+	if (st.pending)
+	{
+		MultiISAFunctions::GSXXH3_64_Block256(&st.st, st.pending);
+		st.pending = bp;
+		st.st.totalLen += GS_BLOCK_SIZE;
+	}
+	else if (st.st.bufferedSize == 0)
+	{
+		st.pending = bp;
+		st.st.totalLen += GS_BLOCK_SIZE;
+	}
+	else
+	{
+		GSXXH3_64bits_update(&st.st, bp, GS_BLOCK_SIZE);
+	}
 }
 
 __fi static void BlockHashAccumulate(BlockHashState& st, const u8* bp, u32 size)
 {
-	GSXXH3_64bits_update(&st, bp, size);
+	BlockHashFlush(st);
+	GSXXH3_64bits_update(&st.st, bp, size);
 }
 
 __fi static GSTextureCache::HashType FinishBlockHash(BlockHashState& st)
 {
-	return GSXXH3_64bits_digest(&st);
+	BlockHashFlush(st);
+	return GSXXH3_64bits_digest(&st.st);
 }
 
 static bool HashTextureLevel(const GIFRegTEX0& TEX0, const GIFRegTEXA& TEXA, GSTextureCache::SourceRegion region, BlockHashState& hash_st)
