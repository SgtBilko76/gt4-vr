+		return;
+	{
+		std::lock_guard lock(m_rrv_acquire->mutex);
+		m_rrv_acquire->quit = true;
+	}
+	m_rrv_acquire->cv.notify_all();
+	m_rrv_acquire->thread.join();
+	m_rrv_acquire.reset();
