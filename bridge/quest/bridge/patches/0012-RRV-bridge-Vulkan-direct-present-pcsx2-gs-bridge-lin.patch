+// RRV GS bridge (pcsx2-gs-bridge-linux.patch). PCSX2 acquires the next image
+// right after each present, on the GS thread, with no timeout. With FIFO that
+// waits until the presentation engine frees an image, and the wait grows with
+// the internal scale (Steam Deck, 14-car race start: 0.3 ms per field at 1x,
+// 2.4 ms at 3x) while the thread has the next field to decode; at 3x that
+// pushed fields over their 16.7 ms (docs/TESTING.md T-DECK-GS-WAIT). Here that
+// one call runs on a helper thread. It follows the even-pacing setting:
+// RRV_PCSX2_GS_PRESENT_PACING=0 (menu "Even frame pacing" off) keeps PCSX2's
+// acquire on the GS thread. Vulkan wants the swap chain externally
+// synchronised: the GS thread does not use it until RrvJoinAcquire() returned
+// (every entry point that touches the swap chain, its images or its semaphores
+// calls it first). Presentation only: which image a frame lands in does not
+// reach the guest.
+void VKSwapChain::AcquireNextImageAfterPresent()
+{
+	static const bool enabled = [] {
+		const char* value = std::getenv("RRV_PCSX2_GS_PRESENT_PACING");
+		return !(value && value[0] == '0');
+	}();
+	g_rrv_wait_stats.async_acquire = enabled;
+	if (!enabled || !m_swap_chain || m_image_acquire_result.has_value())
+	{
+		AcquireNextImage();
+		return;
+	}
+	RrvJoinAcquire();
+	if (!m_rrv_acquire)
+	{
+		m_rrv_acquire = std::make_unique<RrvAcquire>();
+		RrvAcquire* const a = m_rrv_acquire.get();
+		const VkDevice device = GSDeviceVK::GetInstance()->GetDevice();
+		a->thread = std::thread([a, device] {
+#if defined(__linux__)
+			pthread_setname_np(pthread_self(), "rrv-vk-acquire");
+#endif
+			std::unique_lock lock(a->mutex);
+			for (;;)
+			{
+				a->cv.wait(lock, [a] { return a->request || a->quit; });
+				if (a->quit)
+					return;
+				a->request = false;
+				const VkSwapchainKHR swap_chain = a->swap_chain;
+				const VkSemaphore semaphore = a->semaphore;
+				lock.unlock();
+				u32 image = 0;
+				const u64 start = GSRrvNowNs();
+				const VkResult result =
+					vkAcquireNextImageKHR(device, swap_chain, UINT64_MAX, semaphore, VK_NULL_HANDLE, &image);
+				const u64 ns = GSRrvNowNs() - start;
+				lock.lock();
+				a->image = image;
+				a->result = result;
+				a->ns = ns;
+				a->done = true;
+				a->cv.notify_all();
+			}
+		});
+	}
