--- a/pcsx2/GS/Renderers/Vulkan/GSDeviceVK.h
+++ b/pcsx2/GS/Renderers/Vulkan/GSDeviceVK.h
@@ -650,6 +650,12 @@ private:
 	VkShaderModule GetTFXVertexShader(GSHWDrawConfig::VSSelector sel);
 	VkShaderModule GetTFXFragmentShader(const GSHWDrawConfig::PSSelector& sel);
 	VkPipeline CreateTFXPipeline(const PipelineSelector& p);
+	// RRV pipeline collection (Quest): every TFX pipeline created is appended to
+	// <cache>/rrv_tfx_pipelines.bin, and Create() builds all collected ones up front, so a race
+	// does not compile pipelines while it runs (RRV_PIPELINE_COLLECTION).
+	void RrvWarmPipelines();
+	void RrvRecordPipeline(const PipelineSelector& p);
+	std::FILE* m_rrv_pipeline_file = nullptr;
 	VkPipeline GetTFXPipeline(const PipelineSelector& p);
 
 	VkShaderModule GetUtilityVertexShader(const std::string& source, const char* replace_main);
