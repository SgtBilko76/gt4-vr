+// RRV aniso (Quest): per-axis upscale. A scale is a GSVector2 (x, y); these spell out the
+// per-axis forms of what the isotropic code did with a float.
+static __forceinline GSVector4 GSScale4(const GSVector2& s) { return GSVector4(s.x, s.y, s.x, s.y); }
+static __forceinline bool GSScaleIsOne(const GSVector2& s) { return s.x == 1.0f && s.y == 1.0f; }
+static __forceinline float GSScaleMax(const GSVector2& s) { return std::max(s.x, s.y); }
+static __forceinline float GSScaleMin(const GSVector2& s) { return std::min(s.x, s.y); }
+static __forceinline bool GSScaleGreater(const GSVector2& a, const GSVector2& b) { return a.x > b.x || a.y > b.y; } // any axis
+static __forceinline bool GSScaleLess(const GSVector2& a, const GSVector2& b) { return a.x < b.x || a.y < b.y; } // any axis
+static __forceinline GSVector2 GSScaleRcp(const GSVector2& s) { return GSVector2(1.0f / s.x, 1.0f / s.y); }
+
 // conversion
 
