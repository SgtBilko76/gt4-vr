+void GSRendererHW::RrvHudSplitNoteDraw()
+{
+	using namespace rrv_hud_split;
+	const u32 fbp = m_cached_ctx.FRAME.FBP;
+	const GIFRegTEST& test = m_cached_ctx.TEST;
+	if (test.ZTE && test.ZTST >= 2)
+	{
+		Note3d(fbp);
+		return;
+	}
+	if (s_split_fbp == static_cast<int>(fbp))
+		return;
+	const bool tme = PRIM->TME;
+	const u32 tbp = m_cached_ctx.TEX0.TBP0;
+	const GSVector4 box = m_vt.m_min.p.xyxy(m_vt.m_max.p);
+	if (tme && (tbp & 31u) == 0 && (tbp >> 5) != fbp && Is3d(tbp >> 5) && (box.z - box.x) >= 600.0f)
+	{
+		s_comp_fbp = static_cast<int>(fbp);
+		s_comp_tbp = tbp;
+		return;
+	}
+	if (s_comp_fbp != static_cast<int>(fbp) || (tme && tbp == s_comp_tbp) || !IsDisplayed(static_cast<int>(fbp)))
+		return;
+
+	// The first draw over the composite that is not part of it: the HUD starts here.
+	s_split_fbp = static_cast<int>(fbp);
+	GSTextureCache::Target* rt = g_texture_cache->GetExactTarget(fbp << 5, m_cached_ctx.FRAME.FBW, GSTextureCache::RenderTarget, fbp << 5);
+	if (!rt || !rt->m_texture)
+		return;
+	GSTexture* const t = rt->m_texture;
+	Buffer& b = Slot(static_cast<int>(fbp));
+	if (b.clean && b.clean->GetSize() != t->GetSize())
+	{
+		g_gs_device->Recycle(b.clean);
+		b.clean = nullptr;
+	}
+	if (!b.clean)
+		b.clean = g_gs_device->CreateRenderTarget(t->GetWidth(), t->GetHeight(), GSTexture::Format::Color, false);
+	if (!b.clean)
+		return;
+	g_gs_device->CopyRect(t, b.clean, GSVector4i(0, 0, t->GetWidth(), t->GetHeight()), 0, 0);
+	g_gs_device->ClearRenderTarget(t, 0u);
+	b.fbp = static_cast<int>(fbp);
+	b.pending = true;
+	s_splits++;
+#if defined(__ANDROID__)
+	static u32 s_dbg = 0;
+	if (s_dbg < 40 && ++s_dbg)
+		std::fprintf(stderr, "[hud-layer] split fbp 0x%x fbw %u (comp tbp 0x%x) tex %dx%d draw %d\n", fbp, m_cached_ctx.FRAME.FBW,
+			s_comp_tbp, t->GetWidth(), t->GetHeight(), s_n);
+#endif
+}
