+		// Quest VR HUD layer: a split buffer goes out as its clean picture; the HUD drawn over
+		// transparent black is kept for the HUD strip.
+		rrv_hud_split::NoteDisplayed(static_cast<int>(rt->m_TEX0.TBP0 >> 5));
+#if defined(__ANDROID__)
+		static u32 s_dbg_out = 0;
+		if (GSStereo::hud_layer.load(std::memory_order_relaxed) && s_dbg_out < 40 && ++s_dbg_out)
+			std::fprintf(stderr, "[hud-layer] output %d tbp 0x%x (dispfb fbp 0x%x) pend %d/0x%x %d/0x%x\n", i, rt->m_TEX0.TBP0,
+				curFramebuffer.Block() >> 5, rrv_hud_split::s_buf[0].pending, rrv_hud_split::s_buf[0].fbp,
+				rrv_hud_split::s_buf[1].pending, rrv_hud_split::s_buf[1].fbp);
+#endif
+		for (rrv_hud_split::Buffer& b : rrv_hud_split::s_buf)
+		{
+			if (!b.pending || b.fbp != static_cast<int>(rt->m_TEX0.TBP0 >> 5))
+				continue;
+			b.pending = false;
+			if (GSStereo::s_hud_tex && GSStereo::s_hud_tex->GetSize() != t->GetSize())
+			{
+				g_gs_device->Recycle(GSStereo::s_hud_tex);
+				GSStereo::s_hud_tex = nullptr;
+			}
+			if (!GSStereo::s_hud_tex)
+				GSStereo::s_hud_tex = g_gs_device->CreateRenderTarget(t->GetWidth(), t->GetHeight(), GSTexture::Format::Color, false);
+			if (!GSStereo::s_hud_tex || !b.clean)
+				break;
+			const GSVector4i full(0, 0, t->GetWidth(), t->GetHeight());
+			g_gs_device->CopyRect(t, GSStereo::s_hud_tex, full, 0, 0);
+			g_gs_device->CopyRect(b.clean, t, full.rintersect(GSVector4i(0, 0, b.clean->GetWidth(), b.clean->GetHeight())), 0, 0);
+			const GSVector4i fr = curFramebuffer.framebufferRect;
+			GSStereo::s_hud_src = GSVector4(static_cast<float>(fr.x), static_cast<float>(fr.y + y_offset),
+				static_cast<float>(fr.z), static_cast<float>(fr.w + y_offset)) * GSVector4(rt->m_scale, rt->m_scale, rt->m_scale, rt->m_scale);
+			GSStereo::s_hud_age = 0;
+			rrv_hud_split::s_resolves++;
+			break;
+		}
+
 		if (GSConfig.SaveFrame && GSConfig.ShouldDump(s_n, g_perfmon.GetFrame()))
 		{
 			t->Save(GetDrawDumpPath("%05lld_f%05lld_fr%d_%05x_%s.bmp", s_n, g_perfmon.GetFrame(), i, static_cast<int>(TEX0.TBP0), GSUtil::GetPSMName(TEX0.PSM)));
@@ -3466,6 +3633,8 @@ void GSRendererHW::Draw()
 	}
 	if (s_rrv_skip_field.load(std::memory_order_relaxed))
 		return; // RRV_SKIP_FIELD: the bridge drops this field (GSRrvSetSkipField)
+	if (GSStereo::hud_layer.load(std::memory_order_relaxed))
+		RrvHudSplitNoteDraw();
 
 	// Sometimes everything will get reset and it will draw a single black point in the top left corner,
 	// which can cause invalid targets to be created, so might as well skip it.
