+// Quest VR HUD layer, GS thread only. Per field: which frame buffers had depth-tested draws (the
+// 3D targets), the composite (a full-width textured copy of a 3D target into another buffer --
+// GT4's race picture into the frame buffer the CRTC shows) and whether that buffer was split.
+// The split copies the buffer's picture aside ("clean") and clears it to transparent black; the
+// HUD then draws onto nothing. GetOutput, when the CRTC reads the buffer, takes the HUD out and
+// puts the clean picture back, so the eyes get the scene and the HUD goes to its own layer.
+namespace rrv_hud_split
+{
+	static u32 s_3d[8];
+	static u32 s_3d_count = 0;
+	static int s_comp_fbp = -1;
+	static u32 s_comp_tbp = 0;
+	static int s_split_fbp = -1;
+	struct Buffer
+	{
+		int fbp = -1;
+		GSTexture* clean = nullptr;
+		bool pending = false;
+	};
+	static Buffer s_buf[2];
+	// Frame buffers the CRTC read recently (GetOutput). Only these are split: GT4 also copies 3D
+	// targets into its main 3D buffer (post effects), and clearing that one wipes the scene.
+	static int s_displayed[4] = {-1, -1, -1, -1};
+	static u32 s_displayed_next = 0;
+	static bool IsDisplayed(int fbp)
+	{
+		for (int d : s_displayed)
+			if (d == fbp)
+				return true;
+		return false;
+	}
+	static void NoteDisplayed(int fbp)
+	{
+		if (!IsDisplayed(fbp))
+			s_displayed[s_displayed_next++ & 3u] = fbp;
+	}
+	static u32 s_splits = 0, s_resolves = 0, s_fields = 0;
+
+	static bool Is3d(u32 fbp)
+	{
+		for (u32 i = 0; i < s_3d_count; i++)
+			if (s_3d[i] == fbp)
+				return true;
+		return false;
+	}
+	static void Note3d(u32 fbp)
+	{
+		if (!Is3d(fbp) && s_3d_count < std::size(s_3d))
+			s_3d[s_3d_count++] = fbp;
+	}
+	static Buffer& Slot(int fbp)
+	{
+		for (Buffer& b : s_buf)
+			if (b.fbp == fbp)
+				return b;
+		for (Buffer& b : s_buf)
+			if (!b.pending)
+				return b;
+		return s_buf[0];
+	}
+	static void FieldStart()
+	{
+		s_3d_count = 0;
+		s_comp_fbp = -1;
+		s_split_fbp = -1;
+		GSStereo::s_hud_age += (GSStereo::s_hud_age < 0x7fffffffu) ? 1u : 0u;
+		if (++s_fields >= 600)
+		{
+#if defined(__ANDROID__)
+			if (GSStereo::hud_layer.load(std::memory_order_relaxed))
+				std::fprintf(stderr, "[hud-layer] %u splits, %u shown in %u fields\n", s_splits, s_resolves, s_fields);
+#endif
+			s_splits = s_resolves = s_fields = 0;
+		}
+	}
+} // namespace rrv_hud_split
