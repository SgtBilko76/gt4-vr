+void GSDeviceVK::PresentHudRect(GSTexture* sTex, const GSVector4& sRect, const GSVector4& dRect)
+{
+	if (!m_stereo_compile_attempted)
+	{
+		m_stereo_compile_attempted = true;
+		if (!CompileStereoPipelines())
+			Console.Error("GS: Failed to compile stereo pipelines, VR stereo output is disabled.");
+	}
+	if (m_present_hud == VK_NULL_HANDLE || !sTex)
+		return;
+	DisplayConstantBuffer cb;
+	cb.SetSource(sRect, sTex->GetSize());
+	cb.SetTarget(dRect, GetPresentationSize());
+	cb.TimeAndPad = GSVector4::zero();
+	SetUtilityPushConstants(&cb, sizeof(cb));
+	DoStretchRect(static_cast<GSTextureVK*>(sTex), sRect, nullptr, dRect, m_present_hud, Filter::Biln, true);
+}
