+#ifdef ps_hud_layer
+// Quest VR HUD layer. The HUD was drawn over transparent black, so its colour is premultiplied by
+// the PS2 alpha; the target's alpha is the PS2 one (0x80 = 1.0, a single bit in a 16-bit frame
+// buffer). A pixel is at least as opaque as it is bright -- a premultiplied colour cannot exceed
+// its alpha -- which recovers the soft edges a one-bit alpha drops.
+void ps_hud_layer()
+{
+	const vec4 c = sample_c(v_tex);
+	const float a = max(clamp(c.a * (255.0f / 128.0f), 0.0f, 1.0f), max(c.r, max(c.g, c.b)));
+	o_col0 = vec4(c.rgb, a);
+}
+#endif
