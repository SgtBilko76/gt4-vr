+	// Quest VR HUD layer (Wipeout Rewrite VR style: the race HUD on its own flat screen in front of
+	// the 3D view). With hud_layer on, the HW renderer splits the displayed frame buffer at the
+	// first 2D draw after the frame's composite (the full-width copy of a 3D target into it): the
+	// picture up to there is kept for the eyes, everything drawn after it lands on a transparent
+	// background and becomes the HUD. hud_rows reserves that many rows at the bottom of the
+	// presentation surface for the HUD (0 = none); the eyes get the rows above.
+	extern std::atomic<bool> hud_layer;
+	extern std::atomic<int> hud_rows;
+	/// GS thread: the last split's HUD (the frame buffer target after the 2D draws, on transparent
+	/// black) and the source rectangle the CRTC shows from it, in texels. hud_age counts vsyncs
+	/// since it was taken; a stale one is not shown.
+	extern GSTexture* s_hud_tex;
+	extern GSVector4 s_hud_src;
+	extern u32 s_hud_age;
+
 	// Depth rescue, GS thread only. Some games are done with their depth buffer before the frame
 	// is presented -- GT4 reuses its memory as a colour target for post effects, and the texture
 	// cache then destroys the depth target. The HW renderer names the frame's main depth target
diff --git a/pcsx2/GS/Renderers/HW/GSRendererHW.cpp b/pcsx2/GS/Renderers/HW/GSRendererHW.cpp
index ecd29554c9..86f01e686c 100644
--- a/pcsx2/GS/Renderers/HW/GSRendererHW.cpp
+++ b/pcsx2/GS/Renderers/HW/GSRendererHW.cpp
@@ -124,6 +124,83 @@ void GSRendererHW::UpdateSettings(const Pcsx2Config::GSOptions& old_config)
