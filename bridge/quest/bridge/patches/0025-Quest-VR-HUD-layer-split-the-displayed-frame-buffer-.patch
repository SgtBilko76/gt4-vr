 {
 	int index = i >= 0 ? i : 1;
@@ -239,6 +371,41 @@ GSTexture* GSRendererHW::GetOutput(int i, float& scale, int& y_offset)
 			GL_CACHE("HW: Frame y offset %d pixels, unit %d", y_offset, i);
